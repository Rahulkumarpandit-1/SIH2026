# ==============================================================================
# SIH26162 — FastAPI Backend Production Environment Configuration
# ==============================================================================

# NASA FIRMS API MAPKEY (Free registration at https://firms.modaps.eosdis.nasa.gov/api/map_key)
FIRMS_MAP_KEY=51ca9bc710f3add041124d86ddbb631d

# Database Connection (Defaults to local SQLite database in data/app.db)
# For PostgreSQL in production: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./data/app.db

# CORS Allowed Origins (Comma-separated list of origins or * for all)
# Example: https://sih2026-fire.vercel.app,https://my-domain.com
CORS_ORIGINS=*

# Region of Interest Bounding Box [min_lon, min_lat, max_lon, max_lat]
# Defaults to Gujarat Industrial Corridor
DEFAULT_BBOX_MIN_LON=69.0
DEFAULT_BBOX_MIN_LAT=20.0
DEFAULT_BBOX_MAX_LON=74.0
DEFAULT_BBOX_MAX_LAT=24.5

# Default Sensor & Day Range
DEFAULT_SENSOR=VIIRS_SNPP_NRT
DEFAULT_DAY_RANGE=3
